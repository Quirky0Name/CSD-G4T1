# Settings for the root docker-compose.yml. Copy to .env next to it and fill in; never commit .env.
# Keep comments on their own line.

# --- Shared ---
# base64 of 32+ random bytes, one value for every service: openssl rand -base64 32
# (the frontend's hard-coded demo token only works with the team's shared value, as in backend/.env)
JWT_SECRET=
# the one Postgres every service shares; letters and digits only, since it goes into a URL
POSTGRES_PASSWORD=
# the port the website is served on (80 on the server; locally anything free)
WEB_PORT=8088

# --- Third-party APIs (docs/SETUP.md, "Accounts and API keys") ---
OPENALEX_API_KEY=
S2_API_KEY=
# a contact email for Crossref's polite pool; empty sends none
CROSSREF_MAILTO=
# Research Evaluation's impact step is skipped while this is empty
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# --- Updating and Research Evaluation (backend/.env.example explains each) ---
POLL_INTERVAL_HOURS=24
EVALUATION_SNAPSHOT_WINDOW=5
INVESTIGATION_PDF_TIMEOUT_SECONDS=120
IMPACT_LLM_TIMEOUT_SECONDS=120
# notifications are off unless both are set
TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
