# Copy this to .env and fill in real values. Never commit .env.
# See ../SETUP.md for where to get each key.
#
# NOTE: keep comments on their own line, not after a value on the same
# line — Docker Compose's env_file parser does not strip inline
# comments, so "VAR=value  # comment" ends up with the comment baked
# into the value.

# --- Third-party API keys ---
# openalex.org account
OPENALEX_API_KEY=
# Semantic Scholar API key request form
S2_API_KEY=
# platform.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# a contact email for Crossref's polite pool; leave empty to send none
CROSSREF_MAILTO=

# --- Auth ---
# base64 of 32+ random bytes, the same value in every service: openssl rand -base64 32
# (Storage Management decodes it and rejects shorter keys; Updating and Research Evaluation
# check at startup)
JWT_SECRET=

# --- Database (Updating's schema) ---
# Local Postgres (docker compose overrides the host for the containerised app).
# Supabase: use the SESSION pooler (port 5432), not the transaction pooler.
# No Postgres? sqlite+aiosqlite:///./updating.sqlite3 works for local runs.
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/research_assistant

# --- Service-to-service URLs ---
# Hostnames below are for running from the host; docker compose overrides SM_BASE_URL (both
# apps), and RE_BASE_URL and DATABASE_URL (updating), in the containers, and
# research-evaluation/grobid are compose services. Updating and Research Evaluation both call
# Storage Management at SM_BASE_URL.
SM_BASE_URL=http://localhost:8081
RE_BASE_URL=http://localhost:8000
GROBID_URL=http://grobid:8070

# --- Updating ---
POLL_INTERVAL_HOURS=24

# --- Research Evaluation cache ---
CACHE_MAX_ENTRIES=5000

# --- Research Evaluation ---
# how many of the newest snapshots each evaluation compares (N snapshots = N - 1 pairs), 2 or more;
# a change is missed if its nudge keeps failing for more than N - 2 polls in a row
EVALUATION_SNAPSHOT_WINDOW=5
