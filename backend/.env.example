# Copy this to .env and fill in real values. Never commit .env.
# See ../SETUP.md for where to get each key.
#
# NOTE: keep comments on their own line, not after a value on the same
# line — Docker Compose's env_file parser does not strip inline
# comments, so "VAR=value  # comment" ends up with the comment baked
# into the value.

# --- Third-party API keys ---
# openalex.org account
OPENALEX_API_KEY=
# Semantic Scholar API key request form
S2_API_KEY=
# platform.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# any team contact email, for Crossref's polite pool
CROSSREF_MAILTO=team@example.com

# --- Auth ---
# base64 of 32+ random bytes, shared with User Management
JWT_SECRET=

# --- Database (Updating's schema) ---
# Supabase SESSION pooler (port 5432), not the transaction pooler
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

# --- Service-to-service URLs ---
SM_BASE_URL=http://storage-management:8081
RE_BASE_URL=http://research-evaluation:8000
GROBID_URL=http://grobid:8070

# --- Updating ---
# for POST /admin/run-poll
ADMIN_API_KEY=change-me
POLL_INTERVAL_HOURS=24

# --- Research Evaluation cache ---
CACHE_MAX_ENTRIES=5000
